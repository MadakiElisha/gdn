Panels:
  - Class: rviz_common/Displays
    Name: Displays
  - Class: rviz_common/Views
    Name: Views
Visualization Manager:
  Displays:
    - Class: rviz_default_plugins/PointCloud2
      Topic:
        Value: /terrain_cloud
        Depth: 5
        History Policy: Keep Last
        Reliability Policy: Reliable
        Durability Policy: Volatile
      Name: TerrainCloud
      Value: false
      Style: Points
      Size: 6
      Color Transformer: AxisColor
      Axis: Z
    - Class: rviz_default_plugins/Marker
      Topic:
        Value: /terrain_mesh
        Depth: 5
        History Policy: Keep Last
        Reliability Policy: Reliable
        Durability Policy: Volatile
      Name: TerrainMesh
      Value: true
    - Class: rviz_default_plugins/Path
      Topic:
        Value: /gdn_path
      Name: GDN Path
      Color: 255; 0; 0
      Value: true
  Global Options:
    Fixed Frame: map
  Views:
    Current:
      Class: rviz_default_plugins/Orbit
      Distance: 3000
      Focal Point: {X: 0, Y: 0, Z: 0}
      Yaw: 0.0
      Pitch: 1.0
Window Geometry:
  Height: 900
  Width: 1400
