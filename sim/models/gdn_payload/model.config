<?xml version="1.0"?>
<model>
  <name>gdn_payload</name>
  <version>1.0</version>
  <sdf version="1.9">model.sdf</sdf>
  <author><name>GDN</name></author>
  <description>GDN's simulated sensor payload, included by every GDN vehicle
  (x500_gdn, standard_vtol_gdn, rc_cessna_gdn): a downward radar altimeter (height above
  ground, for TRN), the H30WP, Mid-360S and OAK-D Lite IMUs and a TFmini-S (R2.4a,
  published as their drivers do by tools/sim_sensors), and the truth (the payload
  frame's pose). Later: the OAK-D Lite's cameras (R2.4b), the Mid-360S lidar (R2.4c).</description>
</model>
