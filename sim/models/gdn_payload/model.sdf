<?xml version="1.0" encoding="UTF-8"?>
<!--
  GDN's simulated sensor payload, the same on every vehicle (roadmap R2.3). A vehicle
  model includes it and fixes it to its own base_link (sim/models/*_gdn/model.sdf):

    <include>
      <uri>model://gdn_payload</uri>
      <pose relative_to="base_link">0 0 -0.06 0 0 0</pose>   (the mount point)
    </include>
    <joint name="gdn_payload_joint" type="fixed">
      <parent>base_link</parent>
      <child>gdn_payload::gdn_payload_link</child>
    </joint>

  The link's frame is the payload's mount: x forward, y left, z up, as base_link.
  Sensor topics are set explicitly (gdn/...) so the bridge config doesn't depend on the
  world, the vehicle or the instance name.

  Radar altimeter: a 1-beam gpu_lidar pointing straight down in the body frame,
  0.2 to 1500 m, 20 Hz, 0.3 m noise (radar-altimeter class). It measures the slant
  range along body down; tools/sim_adapter.py removes the tilt using PX4's attitude.
  The beam starts at its 0.2 m minimum range, so the airframe right around the mount
  doesn't block it. gpu_lidar renders the terrain, so it needs a working GPU
  (see docs/SETUP.md).

  R2.4a: three IMUs and the TFmini-S. All error-free here: tools/sim_sensors (config/
  sim/sensors.yaml) adds each sensor's errors and timing and publishes what its real
  driver does. Mounts are placeholders until the vehicle profiles (R2.5) hold the real
  extrinsics:
  - H30WP: level, front-left-up, at the payload origin (/imu/data).
  - Mid-360S's IMU: where the lidar goes in R2.4c, upside down (roll 180 deg), so the
    lidar's -7 to 52 deg field of view looks at the ground (/livox/imu).
  - OAK-D Lite's IMU: with the camera, forward and pitched 30 deg down (/oak/imu/data).
  - TFmini-S: a 1-beam gpu_lidar pointing straight down (/tfmini/range). The raw beam
    reads from 2 cm to 13 m; the 0.1 to 12 m limits are applied by tools/sim_sensors.
    It starts that close because Gazebo's beam doesn't see anything nearer than its
    start, which would give "no target" (+inf) for ground a few cm away (a VTOL parked
    on its belly) where the real sensor says "too close" (-inf). Nothing of the
    airframe is below the sensor, so the beam can't hit the vehicle itself.
  The IMUs run at 250 Hz, the physics rate; sim_sensors puts them on each sensor's own
  clock.

  R2.4b: the OAK-D Lite's two OV7251 mono cameras, 640 x 480, 73 deg wide, 30 Hz,
  7.5 cm apart: left at +y, as seen looking out of the camera. They sit either side of
  the OAK-D Lite's IMU and point the same way (forward, 30 deg down), as on the real
  board. Distortion-free and noise-free, and grey at 16 bits (L16): Gazebo's grey
  cameras give linear light, not the gamma-encoded image a camera sends, which would
  look about three times too dark in 8 bits. sim_sensors adds the auto-exposure, the
  8-bit encoding, the read noise, the camera_info and the timing (/oak/left/image_raw,
  /oak/right/image_raw). gz cameras
  look along their +x axis with +z up in the image, like the radar's beam convention.

  R2.4c: the Mid-360S lidar, at its IMU (upside down, so the -7 to 52 deg field looks at
  the ground). Gazebo renders a dense grid of 720 x 120 rays (0.5 deg, -180 to 179.5 deg
  by -7.2 to 52.2 deg) 20 times a second, error-free, out to 100 m; sim_sensors fires
  Livox's measured scan pattern into it at the real unit's point rate, interpolating
  each point's range between the renders around its time, and publishes /livox/lidar
  as livox_ros_driver2/CustomMsg with the 40 m limit, noise and timing.
-->
<sdf version="1.9">
  <model name="gdn_payload">
    <link name="gdn_payload_link">
      <inertial>
        <mass>0.01</mass>
        <inertia><ixx>1e-5</ixx><iyy>1e-5</iyy><izz>1e-5</izz><ixy>0</ixy><ixz>0</ixz><iyz>0</iyz></inertia>
      </inertial>
      <sensor name="gdn_agl_radar" type="gpu_lidar">
        <!-- gpu_lidar fires along its +x axis; pitch +90 deg points that straight down -->
        <pose>0 0 0 0 1.5707963 0</pose>
        <topic>gdn/agl_radar</topic>
        <update_rate>20</update_rate>
        <always_on>1</always_on>
        <visualize>true</visualize>
        <lidar>
          <scan>
            <horizontal><samples>1</samples><resolution>1</resolution><min_angle>0</min_angle><max_angle>0</max_angle></horizontal>
            <vertical><samples>1</samples><resolution>1</resolution><min_angle>0</min_angle><max_angle>0</max_angle></vertical>
          </scan>
          <range><min>0.2</min><max>1500.0</max><resolution>0.01</resolution></range>
          <noise><type>gaussian</type><mean>0.0</mean><stddev>0.3</stddev></noise>
        </lidar>
      </sensor>

      <sensor name="gdn_imu_h30wp" type="imu">
        <pose>0 0 0.02 0 0 0</pose>
        <topic>gdn/imu/h30wp</topic>
        <update_rate>250</update_rate>
        <always_on>1</always_on>
      </sensor>
      <sensor name="gdn_imu_mid360s" type="imu">
        <pose>0 0 -0.05 3.1415927 0 0</pose>
        <topic>gdn/imu/mid360s</topic>
        <update_rate>250</update_rate>
        <always_on>1</always_on>
      </sensor>
      <sensor name="gdn_imu_oakd" type="imu">
        <pose>0.08 0 -0.02 0 0.5235988 0</pose>
        <topic>gdn/imu/oakd</topic>
        <update_rate>250</update_rate>
        <always_on>1</always_on>
      </sensor>

      <sensor name="gdn_oak_left" type="camera">
        <pose>0.08 0.0375 -0.02 0 0.5235988 0</pose>
        <topic>gdn/oak/left</topic>
        <update_rate>30</update_rate>
        <always_on>1</always_on>
        <camera name="oak_left">
          <horizontal_fov>1.2740904</horizontal_fov>
          <image><width>640</width><height>480</height><format>L16</format></image>
          <clip><near>0.05</near><far>3000</far></clip>
        </camera>
      </sensor>
      <sensor name="gdn_oak_right" type="camera">
        <pose>0.08 -0.0375 -0.02 0 0.5235988 0</pose>
        <topic>gdn/oak/right</topic>
        <update_rate>30</update_rate>
        <always_on>1</always_on>
        <camera name="oak_right">
          <horizontal_fov>1.2740904</horizontal_fov>
          <image><width>640</width><height>480</height><format>L16</format></image>
          <clip><near>0.05</near><far>3000</far></clip>
        </camera>
      </sensor>

      <sensor name="gdn_mid360s_lidar" type="gpu_lidar">
        <!-- the Mid-360S's IMU pose (one unit): gpu_lidar's frame is the sensor's -->
        <pose>0 0 -0.05 3.1415927 0 0</pose>
        <topic>gdn/mid360s</topic>
        <update_rate>20</update_rate>
        <always_on>1</always_on>
        <lidar>
          <scan>
            <horizontal><samples>720</samples><resolution>1</resolution><min_angle>-3.14159265</min_angle><max_angle>3.13286600</max_angle></horizontal>
            <vertical><samples>120</samples><resolution>1</resolution><min_angle>-0.12566371</min_angle><max_angle>0.91106186</max_angle></vertical>
          </scan>
          <range><min>0.1</min><max>100.0</max><resolution>0.001</resolution></range>
        </lidar>
      </sensor>

      <sensor name="gdn_tfmini" type="gpu_lidar">
        <!-- gpu_lidar fires along its +x axis; pitch +90 deg points that straight down -->
        <pose>-0.05 0 -0.02 0 1.5707963 0</pose>
        <topic>gdn/tfmini</topic>
        <update_rate>100</update_rate>
        <always_on>1</always_on>
        <lidar>
          <scan>
            <horizontal><samples>1</samples><resolution>1</resolution><min_angle>0</min_angle><max_angle>0</max_angle></horizontal>
            <vertical><samples>1</samples><resolution>1</resolution><min_angle>0</min_angle><max_angle>0</max_angle></vertical>
          </scan>
          <range><min>0.02</min><max>13.0</max><resolution>0.001</resolution></range>
        </lidar>
      </sensor>
    </link>

    <!-- Truth: the payload frame's true pose in the world (ENU, origin = map centre), for
         scoring and checks only, never fed to GDN. It's here, not in the vehicle model,
         because a model's own origin isn't its base_link: PX4's x500, standard_vtol and
         rc_cessna put base_link 0.24 to 0.246 m above it (TEST-035). Here truth is the
         frame every sensor pose below is given in. -->
    <plugin filename="gz-sim-odometry-publisher-system" name="gz::sim::systems::OdometryPublisher">
      <odom_frame>world</odom_frame>
      <robot_base_frame>gdn_payload_link</robot_base_frame>
      <odom_publish_frequency>20</odom_publish_frequency>
      <odom_topic>gdn/truth_odom</odom_topic>
      <dimensions>3</dimensions>
    </plugin>
  </model>
</sdf>
