<?xml version="1.0" encoding="UTF-8"?>
<!--
  PX4 x500 plus the GDN payload. Sensor topics are set explicitly (gdn/...) so the
  bridge config doesn't depend on world or instance names.

  Radar altimeter: a 1-beam gpu_lidar pointing straight down in the body frame,
  0.2 to 1500 m, 20 Hz, 0.3 m noise (radar-altimeter class). It measures the slant
  range along body down; tools/sim_adapter.py removes the tilt using PX4's attitude.
  gpu_lidar renders the terrain, so it needs a working GPU (see docs/SETUP.md).

  Truth: OdometryPublisher gives the true pose in the world frame (ENU, origin = map
  centre). It's only used for scoring, never fed to the filter.

  Display: gdn_show_link draws the x500 4x larger (visual only, hidden from the radar),
  so a following camera can see it. Physics and flight are the real x500's.
-->
<sdf version="1.9">
  <model name="x500_gdn">
    <include merge="true">
      <uri>model://x500</uri>
    </include>

    <link name="gdn_agl_link">
      <pose relative_to="base_link">0 0 -0.06 0 0 0</pose>
      <inertial>
        <mass>0.01</mass>
        <inertia><ixx>1e-5</ixx><iyy>1e-5</iyy><izz>1e-5</izz><ixy>0</ixy><ixz>0</ixz><iyz>0</iyz></inertia>
      </inertial>
      <sensor name="gdn_agl_radar" type="gpu_lidar">
        <!-- gpu_lidar fires along its +x axis; pitch +90 deg points that straight down -->
        <pose>0 0 0 0 1.5707963 0</pose>
        <topic>gdn/agl_radar</topic>
        <update_rate>20</update_rate>
        <always_on>1</always_on>
        <visualize>true</visualize>
        <lidar>
          <scan>
            <horizontal><samples>1</samples><resolution>1</resolution><min_angle>0</min_angle><max_angle>0</max_angle></horizontal>
            <vertical><samples>1</samples><resolution>1</resolution><min_angle>0</min_angle><max_angle>0</max_angle></vertical>
          </scan>
          <range><min>0.2</min><max>1500.0</max><resolution>0.01</resolution></range>
          <noise><type>gaussian</type><mean>0.0</mean><stddev>0.3</stddev></noise>
          <!-- all bits but bit 1: doesn't see gdn_show_link, the 4x display copy below -->
          <visibility_mask>4294967293</visibility_mask>
        </lidar>
      </sensor>
    </link>
    <joint name="gdn_agl_joint" type="fixed">
      <parent>base_link</parent>
      <child>gdn_agl_link</child>
    </joint>

    <!-- A 4x copy of the x500's own visuals (frame, motor mounts, motors, propellers),
         so the drone can be seen from a following camera in a 4 km world. Visual only:
         no collision, 1 g, fixed to base_link, raised 0.681 m so its skids meet the
         ground. The real x500 (mass, arms, rotors, PX4 tuning) is unchanged. Its
         visibility_flags (2) hide it from sensors whose visibility_mask clears bit 1:
         the radar below, and every camera or lidar added to this model must do the same
         (R2.4), or it would see this shell instead of the world. -->
    <link name="gdn_show_link">
      <pose relative_to="base_link">0 0 0.681 0 0 0</pose>
      <inertial>
        <mass>0.001</mass>
        <inertia><ixx>1e-6</ixx><iyy>1e-6</iyy><izz>1e-6</izz><ixy>0</ixy><ixz>0</ixz><iyz>0</iyz></inertia>
      </inertial>
      <visual name="frame">
        <pose>0.0000 0.0000 0.1000 0 0 3.141592654</pose>
        <geometry><mesh><uri>model://x500_base/meshes/NXP-HGD-CF.dae</uri><scale>4.0000 4.0000 4.0000</scale></mesh></geometry>
        <visibility_flags>2</visibility_flags>
        <cast_shadows>true</cast_shadows>
      </visual>
      <visual name="motor_base_0">
        <pose>0.6960 0.6960 0.1280 0 0 -0.45</pose>
        <geometry><mesh><uri>model://x500_base/meshes/5010Base.dae</uri><scale>4.0000 4.0000 4.0000</scale></mesh></geometry>
        <visibility_flags>2</visibility_flags>
        <cast_shadows>true</cast_shadows>
      </visual>
      <visual name="motor_base_1">
        <pose>-0.6960 0.6960 0.1280 0 0 -0.45</pose>
        <geometry><mesh><uri>model://x500_base/meshes/5010Base.dae</uri><scale>4.0000 4.0000 4.0000</scale></mesh></geometry>
        <visibility_flags>2</visibility_flags>
        <cast_shadows>true</cast_shadows>
      </visual>
      <visual name="motor_base_2">
        <pose>0.6960 -0.6960 0.1280 0 0 -0.45</pose>
        <geometry><mesh><uri>model://x500_base/meshes/5010Base.dae</uri><scale>4.0000 4.0000 4.0000</scale></mesh></geometry>
        <visibility_flags>2</visibility_flags>
        <cast_shadows>true</cast_shadows>
      </visual>
      <visual name="motor_base_3">
        <pose>-0.6960 -0.6960 0.1280 0 0 -0.45</pose>
        <geometry><mesh><uri>model://x500_base/meshes/5010Base.dae</uri><scale>4.0000 4.0000 4.0000</scale></mesh></geometry>
        <visibility_flags>2</visibility_flags>
        <cast_shadows>true</cast_shadows>
      </visual>
      <visual name="prop_0">
        <pose>0.6080 -1.2815 0.1760 0 0 0</pose>
        <geometry><mesh><uri>model://x500_base/meshes/1345_prop_ccw.stl</uri><scale>3.3846 3.3846 3.3846</scale></mesh></geometry>
        <visibility_flags>2</visibility_flags>
        <cast_shadows>true</cast_shadows>
      </visual>
      <visual name="motor_bell_0">
        <pose>0.6960 -0.6960 0.1120 0 0 0</pose>
        <geometry><mesh><uri>model://x500_base/meshes/5010Bell.dae</uri><scale>4.0000 4.0000 4.0000</scale></mesh></geometry>
        <visibility_flags>2</visibility_flags>
        <cast_shadows>true</cast_shadows>
      </visual>
      <visual name="prop_1">
        <pose>-0.7840 0.1105 0.1760 0 0 0</pose>
        <geometry><mesh><uri>model://x500_base/meshes/1345_prop_ccw.stl</uri><scale>3.3846 3.3846 3.3846</scale></mesh></geometry>
        <visibility_flags>2</visibility_flags>
        <cast_shadows>true</cast_shadows>
      </visual>
      <visual name="motor_bell_1">
        <pose>-0.6960 0.6960 0.1120 0 0 0</pose>
        <geometry><mesh><uri>model://x500_base/meshes/5010Bell.dae</uri><scale>4.0000 4.0000 4.0000</scale></mesh></geometry>
        <visibility_flags>2</visibility_flags>
        <cast_shadows>true</cast_shadows>
      </visual>
      <visual name="prop_2">
        <pose>0.6080 0.1105 0.1760 0 0 0</pose>
        <geometry><mesh><uri>model://x500_base/meshes/1345_prop_cw.stl</uri><scale>3.3846 3.3846 3.3846</scale></mesh></geometry>
        <visibility_flags>2</visibility_flags>
        <cast_shadows>true</cast_shadows>
      </visual>
      <visual name="motor_bell_2">
        <pose>0.6960 0.6960 0.1120 0 0 0</pose>
        <geometry><mesh><uri>model://x500_base/meshes/5010Bell.dae</uri><scale>4.0000 4.0000 4.0000</scale></mesh></geometry>
        <visibility_flags>2</visibility_flags>
        <cast_shadows>true</cast_shadows>
      </visual>
      <visual name="prop_3">
        <pose>-0.7840 -1.2815 0.1760 0 0 0</pose>
        <geometry><mesh><uri>model://x500_base/meshes/1345_prop_cw.stl</uri><scale>3.3846 3.3846 3.3846</scale></mesh></geometry>
        <visibility_flags>2</visibility_flags>
        <cast_shadows>true</cast_shadows>
      </visual>
      <visual name="motor_bell_3">
        <pose>-0.6960 -0.6960 0.1120 0 0 0</pose>
        <geometry><mesh><uri>model://x500_base/meshes/5010Bell.dae</uri><scale>4.0000 4.0000 4.0000</scale></mesh></geometry>
        <visibility_flags>2</visibility_flags>
        <cast_shadows>true</cast_shadows>
      </visual>
    </link>
    <joint name="gdn_show_joint" type="fixed">
      <parent>base_link</parent>
      <child>gdn_show_link</child>
    </joint>

    <plugin filename="gz-sim-odometry-publisher-system" name="gz::sim::systems::OdometryPublisher">
      <odom_frame>world</odom_frame>
      <robot_base_frame>base_link</robot_base_frame>
      <odom_publish_frequency>20</odom_publish_frequency>
      <odom_topic>gdn/truth_odom</odom_topic>
      <dimensions>3</dimensions>
    </plugin>
  </model>
</sdf>
