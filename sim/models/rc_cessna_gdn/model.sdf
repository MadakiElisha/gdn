<?xml version="1.0" encoding="UTF-8"?>
<!--
  PX4's rc_cessna fixed-wing, plus the GDN payload (sim/models/gdn_payload) fixed under the fuselage (its base_link box is 10 cm tall).
  Its airframe, PX4 settings and how it flies are in tools/sim_vehicles.py.

  Truth comes from the payload (gdn/truth_odom: the payload frame's true pose), so it's
  in the same frame as the payload's sensors on every vehicle.
-->
<sdf version="1.9">
  <model name="rc_cessna_gdn">
    <include merge="true">
      <uri>model://rc_cessna</uri>
    </include>

    <include>
      <uri>model://gdn_payload</uri>
      <pose relative_to="base_link">0 0 -0.06 0 0 0</pose>
    </include>
    <joint name="gdn_payload_joint" type="fixed">
      <parent>base_link</parent>
      <child>gdn_payload::gdn_payload_link</child>
    </joint>

  </model>
</sdf>
