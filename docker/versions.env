# R2.1: what the GDN dev image pins. tools/docker_dev.sh passes these to the build, and
# tools/docker_check.sh checks the built image against them. Change a pin here only.
#
# Base: ROS 2 Jazzy desktop (Ubuntu 24.04, RViz included), by digest so a re-push of
# the tag can't change it. Gazebo Harmonic comes from PX4's own setup script (apt,
# packages.osrfoundation.org); its exact package versions are recorded in the image at
# /opt/gdn/packages.txt.
BASE_IMAGE=osrf/ros:jazzy-desktop@sha256:2f520187e84304fffb60d19c9a7d8e2e79d563a6e579a090427e5994eb1b8c45
PX4_TAG=v1.16.2
PX4_COMMIT=54f0455ffcd755534539a7cf33a09a20bf71d29d
# v2.4.2 no longer builds: the Fast-DDS 2.12.x branch it pulls is gone upstream.
XRCE_TAG=v2.4.3
XRCE_COMMIT=73622810d984349b80bbac0ef55fc0b694d62222
